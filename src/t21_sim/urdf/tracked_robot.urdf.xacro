<?xml version="1.0"?>
<robot name="t21" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ──────────────── CONSTANTS ──────────────── -->
  <xacro:property name="scale_small" value="1"/>
  <xacro:property name="scale_big" value="0.001"/>
  <xacro:property name="color_grey" value="0.6 0.6 0.6 1.0"/>
  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_length" value="0.02"/>
  <xacro:property name="lidar_radius" value="0.03"/>
  <xacro:property name="lidar_length" value="0.05"/>

  <!-- ──────────────── MACROS ──────────────── -->
  <xacro:macro name="cylinder_link" params="name radius length mass *visual *collision">
    <link name="${name}">
      <inertial>
        <mass value="${mass}"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="${mass*(3*radius*radius + length*length)/12}" ixy="0" ixz="0"
                 iyy="${mass*(3*radius*radius + length*length)/12}" iyz="0"
                 izz="${mass*(radius*radius)/2}"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${radius}" length="${length}"/>
        </geometry>
        <xacro:insert_block name="visual"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${radius}" length="${length}"/>
        </geometry>
        <xacro:insert_block name="collision"/>
      </collision>
    </link>
  </xacro:macro>

  <!-- Основной макрос для меш-объектов -->
  <xacro:macro name="add_link" params="name mesh scale color rpy xyz mass">
    <link name="${name}">
      <inertial>
        <mass value="${mass}"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="${mass*0.1}" ixy="0" ixz="0"
                 iyy="${mass*0.1}" iyz="0"
                 izz="${mass*0.1}"/>
      </inertial>
      <collision>
        <origin rpy="${rpy}" xyz="${xyz}"/>
        <geometry>
          <mesh filename="package://t21_sim/meshes/${mesh}"
                scale="${scale} ${scale} ${scale}"/>
        </geometry>
      </collision>
      <visual>
        <origin rpy="${rpy}" xyz="${xyz}"/>
        <geometry>
          <mesh filename="package://t21_sim/meshes/${mesh}"
                scale="${scale} ${scale} ${scale}"/>
        </geometry>
        <material name="Grey">
          <color rgba="${color}"/>
        </material>
      </visual>
    </link>
  </xacro:macro>

  <link name="world"/>

  <!-- ──────────────── BASE ──────────────── -->
  <xacro:add_link name="base_link"
                 mesh="base.stl"
                 scale="${scale_small}"
                 color="${color_grey}"
                 rpy="0 0 0"
                 xyz="0 0 0"
                 mass="5.0"/>

  <joint name="base_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ──────────────── FLIPPER / GEOMETRY ──────────────── -->
  <xacro:add_link name="geom_link"
                 mesh="fliper.stl"
                 scale="${scale_small}"
                 color="${color_grey}"
                 rpy="0 0 0"
                 xyz="0 0 0"
                 mass="1.5"/>

  <joint name="geom_joint" type="revolute">
    <parent link="base_link"/>
    <child link="geom_link"/>
    <origin xyz="0.22513 0.1925 0.07335" rpy="-1.57 4.71239 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.174533" upper="5.93412" effort="1000" velocity="1"/>
  </joint>

  <!-- ──────────────── WHEELS ──────────────── -->
  <xacro:cylinder_link name="wheel_left_link" 
                      radius="${wheel_radius}" 
                      length="${wheel_length}" 
                      mass="0.5">
    <visual>
      <material name="Invisible">
        <color rgba="0 0 0 0"/>
      </material>
    </visual>
    <collision/>
  </xacro:cylinder_link>

  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left_link"/>
    <origin xyz="0 0.1865 0.065" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <gazebo reference="wheel_left_link">
    <mu1 value="1.0"/>
    <mu2 value="0.1"/>
    <fdir1 value="0 0 0"/>
    <maxContacts value="1"/>
    <material>Gazebo/Invisible</material>
  </gazebo>

  <xacro:cylinder_link name="wheel_right_link" 
                      radius="${wheel_radius}" 
                      length="${wheel_length}" 
                      mass="0.5">
    <visual>
      <material name="Invisible">
        <color rgba="0 0 0 0"/>
      </material>
    </visual>
    <collision/>
  </xacro:cylinder_link>

  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right_link"/>
    <origin xyz="0 -0.1865 0.065" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <gazebo reference="wheel_right_link">
    <mu1 value="1.0"/>
    <mu2 value="0.1"/>
    <fdir1 value="0 0 0"/>
    <maxContacts value="1"/>
    <material>Gazebo/Invisible</material>
  </gazebo>

  <!-- ──────────────── BOX AND SENSORS ──────────────── -->
  <xacro:add_link name="big_box_link"
                 mesh="big_box.stl"
                 scale="${scale_big}"
                 color="${color_grey}"
                 rpy="0 0 0"
                 xyz="0 0 0"
                 mass="0.3"/>

  <joint name="big_box_joint" type="fixed">
    <parent link="base_link"/>
    <child link="big_box_link"/>
    <origin xyz="0.265 -0.093 0.133" rpy="0 0 0"/>
  </joint>

  <!-- Лидар в виде вертикального цилиндра -->
  <xacro:cylinder_link name="lidar_link" 
                      radius="${lidar_radius}" 
                      length="${lidar_length}" 
                      mass="0.1">
    <visual>
      <material name="DarkGrey">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
    <collision/>
  </xacro:cylinder_link>

  <joint name="lidar_joint" type="fixed">
    <parent link="big_box_link"/>
    <child link="lidar_link"/>
    <origin xyz="-0.111 0.092 0.118" rpy="0 0 1.5708"/> <!-- Повернут на 90 градусов -->
  </joint>

</robot>