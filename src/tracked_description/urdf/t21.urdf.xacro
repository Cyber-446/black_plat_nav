<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="t21">
  <xacro:arg name="prefix" default=""/>
  <xacro:arg name="use_lidar" default="false"/>
  <!-- геометрия -->
  <xacro:include filename="$(find tracked_description)/urdf/tracked_robot.urdf.xacro"/>

  <!-- блок ros2_control -->
  <xacro:include filename="$(find tracked_description)/config/t21.ros2_control.xacro"/>

  <!-- вызываем макрос, передавая имя и префикс -->
  <xacro:t21_ros2_control name="t21" prefix="$(arg prefix)"/>

  <xacro:if value="${use_lidar}">
    <xacro:VLP-16 parent="lidar_link" 
                name="velodyne" 
                topic="/velodyne_points" 
                organize_cloud="false" 
                hz="10" 
                lasers="16"
                samples="400" 
                collision_range="0.3" 
                min_range="0.1" 
                max_range="25.0"    
                min_angle="-${pi/2}" 
                max_angle="${pi/2}" 
                gpu="false">
                <origin xyz="0 0 0" rpy="0 0 0" />
    </xacro:VLP-16>
  </xacro:if>
  <!-- <xacro:include filename="$(find realsense2_description)/urdf/_d415.urdf.xacro"/>
  <xacro:sensor_d415 parent="front_camera_link" use_nominal_extrinsics="true">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:sensor_d415>
  <xacro:include filename="depth_camera.xacro"/> -->
</robot>
