<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  
  <xacro:property name="lidar_translation" value="-0.111 0.092 0.118"/>

    <link name="lidar_link">
      <inertial>
        <mass value="1e-6"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="1e-6" iyy="1e-6" izz="1e-6" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>

    <joint name="lidar_joint" type="fixed">
      <parent link="big_box_link"/>
      <child link="lidar_link"/>
      <origin xyz="${lidar_translation}" rpy="0 0 0"/>
    </joint>

  <!-- блок симуляции VLP-16-->
  <xacro:if value="$(arg use_sim_time)">
    <xacro:include filename="$(find velodyne_description)/urdf/VLP-16.urdf.xacro"/>
    <xacro:VLP-16 
      parent="lidar_link" 
      name="velodyne" 
      topic="/velodyne_points" 
      organize_cloud="false" 
      hz="10" 
      lasers="16"
      samples="400" 
      min_range="0.5" 
      max_range="25.0"   
      gpu="false">
      <!-- 
      min_angle="-0.0"  
      max_angle="6.2831853" 
      -->
      <origin xyz="0 0 -0.035" rpy="0 0 0" />
    </xacro:VLP-16>
  </xacro:if>
</robot>